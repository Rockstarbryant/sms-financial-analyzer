# ============================================================
# DATABASE
# ============================================================

# Production / Render:
# DATABASE_URL=postgresql://username:password@host:5432/database

# Leave DATABASE_URL empty for local development.
# The application will automatically use SQLite.
DATABASE_URL=

# Local SQLite fallback
SMS_ANALYZER_DB_PATH=./data/sms_analyzer.db


# ============================================================
# SERVER
# ============================================================

# Local development
SMS_ANALYZER_HOST=127.0.0.1

# Render provides PORT automatically.
# Do not hardcode Render's production port here.
SMS_ANALYZER_PORT=8000


# ============================================================
# SAMPLE DATA
# ============================================================

SMS_ANALYZER_SAMPLE_DATA_DIR=../sample_data


# ============================================================
# APPLICATION
# ============================================================

SMS_ANALYZER_CURRENCY=KES

SMS_ANALYZER_DEBUG=false


# ============================================================
# JWT AUTHENTICATION
# ============================================================

# IMPORTANT:
# Generate a strong random value for production.
SMS_ANALYZER_JWT_SECRET=change-me-in-production

SMS_ANALYZER_JWT_ALGORITHM=HS256

# 7 days
SMS_ANALYZER_JWT_EXPIRE_MINUTES=10080


# ============================================================
# CORS
# ============================================================

# Example:
# SMS_ANALYZER_CORS_ORIGINS=https://your-app.vercel.app

SMS_ANALYZER_CORS_ORIGINS=